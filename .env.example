# ─────────────────────────────────────────────────────────────
# ReliefLink AI — Environment Variables
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────────────────────

# ✅ REQUIRED — OpenAI API key for GPT and embeddings
OPENAI_API_KEY=your_openai_api_key_here

# 📰 OPTIONAL — NewsAPI.org key for real-time crisis headlines
# Get free key at https://newsapi.org/register
# Without this, the app uses rich built-in sample data
NEWS_API_KEY=your_newsapi_key_here

# 📊 OPTIONAL — LangSmith for LangGraph tracing & observability
# Get key at https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=relieflink-ai

# 🌐 Backend URL (change if deploying on different host/port)
BACKEND_URL=http://localhost:8000
